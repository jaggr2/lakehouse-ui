{
  "name": "lakehouse-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lakehouse UI API — Hono backend over the lakehouse artifacts (catalog, quality/trust, usage/impact).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:spec": "tsx scripts/check-spec.ts",
    "ingest:athena": "tsx src/cli/ingest-athena-usage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.700.0",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
